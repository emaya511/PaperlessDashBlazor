@page "/pages/{Slug}"
@inject PaperlessDash Dash
@inject PaperlessService PaperlessService
@rendermode InteractiveServer
@implements IDisposable

@if (_currentPage is not null)
{
    <PageTitle>@_currentPage.Title</PageTitle>

    <div class="dynamic-page" @onclick="ClosePicker">

        <div class="page-header">
            <h1>@_currentPage.Title</h1>

            @* ── Add Card button + picker ────────────────────── *@
            <div class="add-card-wrapper" @onclick:stopPropagation="true">
                <button class="btn-add-card" @onclick="TogglePicker" title="Add card">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                    </svg>
                    Add Card
                </button>

                @if (_showPicker)
                {
                    <div class="size-picker">
                        <p class="picker-label">Choose card type</p>
                        <div class="size-options">
                            <button class="size-option" @onclick="OpenDocDialog">
                                <div class="size-preview doc-preview"></div>
                                <span>Doc</span>
                                <small>1 × 1</small>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* ── Card grid ────────────────────────────────────────── *@
        @if (_currentPage.Cards.Count == 0)
        {
            <p class="page-empty-hint">No cards yet. Click <strong>Add Card</strong> to get started.</p>
        }
        else
        {
            <div class="card-grid">
                @foreach (var card in _currentPage.Cards)
                {
                    <DocCard Card="card"
                             OnDelete="() => DeleteCard(card.Id)" />
                }
            </div>
        }
    </div>
}
else if (_loaded)
{
    <PageTitle>Page Not Found</PageTitle>
    <h1>Page not found</h1>
    <p>No page with slug <strong>@Slug</strong> exists.</p>
}
else
{
    <p>Loading…</p>
}

@* ── Doc card setup dialog ──────────────────────────────────── *@
@if (_showDocDialog)
{
    <div class="modal-backdrop" @onclick="CloseDocDialog"></div>
    <div class="doc-dialog" @onclick:stopPropagation="true">
        <h5>Configure Doc Card</h5>
        <p class="dialog-hint">Choose a tag — the card will display all documents with that tag.</p>

        @if (_tagsLoading)
        {
            <p class="dialog-loading">Loading tags from Paperless-NGX…</p>
        }
        else if (_tags.Count == 0)
        {
            <p class="dialog-error">⚠ Could not load tags. Check your <code>.env</code> connection settings.</p>
        }
        else
        {
            if (_tagSelected)
            {
                <div class="tag-list">
                    @foreach (var doc in _previewDocs)
                    {
                        <button class="tag-item @(_selectedDoc?.Title == doc.Title ? "selected" : "")"
                                @onclick="() => _selectedDoc = doc">
                            <span class="tag-label">@doc.Title</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <input type="text" class="tag-search" placeholder="Search tags…"
                       @bind="_tagSearch" @bind:event="oninput" />

                <div class="tag-list">
                    @foreach (var tag in FilteredTags)
                    {
                        <button class="tag-item @(_selectedTag?.Id == tag.Id ? "selected" : "")"
                                @onclick="() => OnTagSelectedAsync(tag)">
                            <span class="tag-dot" style="background:@tag.CssColour"></span>
                            <span class="tag-label">@tag.Name</span>
                            <span class="tag-count">@tag.DocumentCount docs</span>
                        </button>
                    }
                </div>
            }
        }

        <div class="dialog-actions">
            <button class="btn-cancel" @onclick="CloseDocDialog">Cancel</button>
            <button class="btn-create" @onclick="ConfirmDocCard"
                    disabled="@(_selectedDoc is null || _savingCard)">
                @(_savingCard ? "Saving…" : "Add Card")
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private DashPage? _currentPage;
    private bool _showPicker;
    private bool _loaded;

    // ── Doc dialog state (UI-only) ────────────────────────────────────────
    private bool _showDocDialog;
    private bool _tagsLoading;
    private bool _savingCard;
    private bool _tagSelected;
    private List<PaperlessTag> _tags = [];
    private PaperlessTag? _selectedTag;
    private PaperlessDocument? _selectedDoc;
    private string _tagSearch = string.Empty;
    private List<PaperlessDocument> _previewDocs = [];

    private IEnumerable<PaperlessTag> FilteredTags =>
        string.IsNullOrWhiteSpace(_tagSearch)
            ? _tags
            : _tags.Where(t => t.Name.Contains(_tagSearch, StringComparison.OrdinalIgnoreCase));

    // ── Lifecycle ─────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        Dash.OnChange += OnDashChanged;
        await LoadPageAsync();
    }

    protected override async Task OnParametersSetAsync() => await LoadPageAsync();

    private async Task LoadPageAsync()
    {
        await Dash.EnsureLoadedAsync();

        // Unsubscribe from previous page
        if (_currentPage is not null)
            _currentPage.OnChange -= OnPageChanged;

        _currentPage = Dash.GetPageBySlug(Slug);

        if (_currentPage is not null)
        {
            _currentPage.OnChange += OnPageChanged;
            await _currentPage.EnsureCardsLoadedAsync();
        }

        _loaded = true;
        StateHasChanged();
    }

    private void OnDashChanged() => InvokeAsync(() =>
    {
        _currentPage = Dash.GetPageBySlug(Slug);
        StateHasChanged();
    });

    private void OnPageChanged() => InvokeAsync(StateHasChanged);

    // ── Picker ────────────────────────────────────────────────────────────

    private void TogglePicker() => _showPicker = !_showPicker;
    private void ClosePicker() => _showPicker = false;

    // ── Doc dialog ────────────────────────────────────────────────────────

    private async Task OnTagSelectedAsync(PaperlessTag selectedTag)
    {
        _selectedTag = selectedTag;
        _tagSelected = true;

        var (docs, _) = await PaperlessService.GetDocumentsByTagAsync(selectedTag.Id);
        _previewDocs = docs;
        StateHasChanged();
    }

    private async Task OpenDocDialog()
    {
        _showPicker = false;
        _selectedTag = null;
        _selectedDoc = null;
        _tagSearch = string.Empty;
        _tagSelected = false;
        _showDocDialog = true;
        _tagsLoading = true;
        StateHasChanged();

        _tags = await PaperlessService.GetTagsAsync();
        _tagsLoading = false;
        StateHasChanged();
    }

    private void CloseDocDialog()
    {
        _showDocDialog = false;
        _selectedTag = null;
        _selectedDoc = null;
        _tagSelected = false;
    }

    private async Task ConfirmDocCard()
    {
        if (_selectedDoc is null || _currentPage is null) return;
        _savingCard = true;
        await _currentPage.AddCardAsync(_selectedDoc.Id, _selectedDoc.Title ?? string.Empty);
        _savingCard = false;
        CloseDocDialog();
    }

    // ── Delete ────────────────────────────────────────────────────────────

    private async Task DeleteCard(Guid cardId)
    {
        if (_currentPage is null) return;
        await _currentPage.DeleteCardAsync(cardId);
    }

    public void Dispose()
    {
        Dash.OnChange -= OnDashChanged;
        if (_currentPage is not null)
            _currentPage.OnChange -= OnPageChanged;
    }
}
